---
/** Profil člena tímu: portrét alebo iniciálky, bio a citát. */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { TeamMember } from '@/data/team';

interface Props {
  member: TeamMember;
}
const { member } = Astro.props;
---

<article class="flex flex-wrap gap-7 items-start">
  {
    member.photo ? (
      <div class="flex-[0_0_200px] max-w-full aspect-[4/5] overflow-hidden rounded-sm bg-stone">
        <Picture
          src={member.photo}
          alt={`Portrét: ${member.name}`}
          widths={[200, 400]}
          sizes="200px"
          formats={['avif']}
          fallbackFormat="webp"
          loading="lazy"
          pictureAttributes={{ class: 'block w-full h-full' }}
          class="block w-full h-full object-cover"
        />
      </div>
    ) : (
      <div class="pattern-light flex-[0_0_200px] max-w-full aspect-[4/5] flex items-center justify-center p-4 rounded-sm bg-stone">
        <span aria-hidden="true" class="font-serif text-[52px] leading-none">{member.initials}</span>
      </div>
    )
  }
  <div class="flex-[1_1_260px] flex flex-col gap-3 min-w-0">
    <h3 class="m-0 font-serif font-medium text-[26px] leading-[1.25]">{member.name}</h3>
    <p class="m-0 text-[15px] font-bold text-accent">{member.role}</p>
    <p class="m-0 text-[16px] text-ink-2">{member.bio}</p>
    <figure class="m-0 mt-[10px] pt-[18px] border-t border-ink/18 flex flex-col gap-[10px]">
      <Icon name="quote" class="text-accent" />
      <blockquote class="m-0 font-light text-[20px] leading-[1.55]">{member.quote}</blockquote>
      <figcaption class="text-[14px] font-bold text-ink-2">{member.name}</figcaption>
    </figure>
  </div>
</article>
