---
/** Inline SVG ikony z dizajnu. Dekoratívne (aria-hidden). */
export type IconName = 'clock' | 'chat' | 'database' | 'quote' | 'check' | 'info';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size, class: className = '' } = Astro.props;

const icons: Record<IconName, { viewBox: string; w: number; h: number; fill?: string; body: string }> = {
  clock: {
    viewBox: '0 0 48 48',
    w: 44,
    h: 44,
    body: '<circle cx="24" cy="25" r="16"/><path d="M24 15v10l6.5 4"/><path d="M18 5h12"/><path d="M24 5v4"/>',
  },
  chat: {
    viewBox: '0 0 48 48',
    w: 44,
    h: 44,
    body: '<path d="M8 12.5c0-2.5 2-4.5 4.5-4.5h23c2.5 0 4.5 2 4.5 4.5v15c0 2.5-2 4.5-4.5 4.5H21l-8 7v-7h-.5C10 32 8 30 8 27.5z"/><path d="M17 20h14"/><path d="M17 25h8"/>',
  },
  database: {
    viewBox: '0 0 48 48',
    w: 44,
    h: 44,
    body: '<ellipse cx="24" cy="11" rx="14" ry="5"/><path d="M10 11v13c0 2.8 6.3 5 14 5s14-2.2 14-5V11"/><path d="M10 24v13c0 2.8 6.3 5 14 5s14-2.2 14-5V24"/>',
  },
  quote: {
    viewBox: '0 0 28 20',
    w: 28,
    h: 20,
    fill: 'currentColor',
    body: '<path d="M0 20V12.6C0 5.8 3.4 1.6 10.2 0l1.1 2.6C7.5 3.9 5.6 6.4 5.4 10H11v10H0zm16 0V12.6C16 5.8 19.4 1.6 26.2 0l1.1 2.6c-3.8 1.3-5.7 3.8-5.9 7.4H27v10H16z"/>',
  },
  check: {
    viewBox: '0 0 56 56',
    w: 56,
    h: 56,
    body: '<circle cx="28" cy="28" r="26"/><path d="M17 29l7.5 7.5L40 20"/>',
  },
  info: {
    viewBox: '0 0 20 20',
    w: 18,
    h: 18,
    body: '<circle cx="10" cy="10" r="8"/><path d="M10 9v5"/><path d="M10 6.2v.1"/>',
  },
};

const icon = icons[name];
const width = size ?? icon.w;
const height = size ? Math.round((size * icon.h) / icon.w) : icon.h;
const strokeWidth = name === 'check' ? 1.4 : name === 'info' ? 1.5 : 1.3;
const strokeAttrs = icon.fill
  ? ({ fill: icon.fill } as const)
  : ({ fill: 'none', stroke: 'currentColor', 'stroke-width': strokeWidth, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const);
---

<svg
  viewBox={icon.viewBox}
  width={width}
  height={height}
  aria-hidden="true"
  class={className}
  {...strokeAttrs}
  set:html={icon.body}
/>
