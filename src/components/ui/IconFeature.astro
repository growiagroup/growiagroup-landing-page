---
/** Položka v mriežke „Pre koho“: ikona, nadpis a blok „Ako pomôžeme“. */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  icon: IconName;
  title: string;
  helpLabel: string;
  help: string;
}
const { icon, title, helpLabel, help } = Astro.props;
---

<div class="flex flex-col gap-[14px] py-8 border-b border-ink/12">
  <Icon name={icon} class="text-accent" />
  <h3 class="m-0 font-serif font-medium text-[24px] leading-[1.25]">{title}</h3>
  <p class="m-0 mt-auto pt-4 border-t border-dashed border-ink/32 text-[16px] leading-[1.55]">
    <b class="block mb-1 label-caps text-accent">{helpLabel}</b>
    {help}
  </p>
</div>
