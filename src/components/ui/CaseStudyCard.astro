---
/** Tmavá karta prípadovej štúdie s tromi číslami. */
import type { CaseStudy } from '@/data/results';

interface Props {
  study: CaseStudy;
  labels: { case: string; challenge: string; results: string; benefit: string };
}
const { study, labels } = Astro.props;
---

<article class="flex flex-col gap-[22px] p-[clamp(24px,3.2vw,40px)] rounded-sm bg-ink text-bg">
  <div class="flex flex-col gap-2">
    <p class="m-0 label-caps text-bg">{labels.case}</p>
    <h3 class="m-0 font-serif font-medium text-[clamp(24px,1.2rem+0.8vw,30px)] leading-[1.2]">{study.title}</h3>
  </div>
  <div class="flex flex-col gap-[6px]">
    <p class="m-0 label-caps text-taupe">{labels.challenge}</p>
    <p class="m-0 text-[16px] leading-[1.6]">{study.challenge}</p>
  </div>
  <div class="flex flex-col gap-3">
    <p class="m-0 label-caps text-taupe">{labels.results}</p>
    <div class="grid grid-cols-3 gap-3 py-4 border-y border-bg/24">
      {study.stats.map((stat) => (
        <div class="flex flex-col gap-1 min-w-0">
          <p class="m-0 font-serif text-[clamp(26px,1.3rem+0.8vw,34px)] leading-[1.05] tabular-nums lining-nums whitespace-nowrap">{stat.value}</p>
          <p class="m-0 text-[14px] leading-[1.35]">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
  <div class="flex flex-col gap-[6px]">
    <p class="m-0 label-caps text-taupe">{labels.benefit}</p>
    <p class="m-0 text-[16px] leading-[1.6]">{study.benefit}</p>
  </div>
</article>
