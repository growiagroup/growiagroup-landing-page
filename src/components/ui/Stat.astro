---
/** Veľké číslo s popisom (súhrnné výsledky). */
interface Props {
  value: string;
  suffix?: string;
  label: string;
}
const { value, suffix, label } = Astro.props;
---

<div class="flex flex-col gap-[10px] py-[clamp(24px,3vw,36px)] border-b border-ink/18">
  <p class="m-0 font-serif font-semibold text-[clamp(52px,2.6rem+2.6vw,84px)] leading-none tracking-[-0.01em] text-accent tabular-nums lining-nums whitespace-nowrap">
    {value}{suffix && <> <span class="text-[0.42em] font-medium tracking-normal">{suffix}</span></>}
  </p>
  <p class="m-0 text-[18px] font-bold leading-[1.4]">{label}</p>
</div>
