    --cc-secondary-color: #5f5955;
    --cc-btn-primary-bg: #742f46;
    --cc-btn-primary-color: #ffffff;
    --cc-btn-primary-border-color: #742f46;
    --cc-btn-primary-hover-bg: #5c2337;
    --cc-btn-primary-hover-border-color: #5c2337;
    --cc-btn-primary-hover-color: #ffffff;
    --cc-btn-secondary-bg: #ede5dc;
    --cc-btn-secondary-color: #393431;
    --cc-btn-secondary-border-color: #ede5dc;
    --cc-btn-secondary-hover-bg: #ddd0c3;
    --cc-btn-secondary-hover-border-color: #ddd0c3;
    --cc-btn-secondary-hover-color: #393431;
    --cc-separator-border-color: rgb(57 52 49 / 0.14);
    --cc-toggle-on-bg: #742f46;
    --cc-toggle-off-bg: #aa978d;
    --cc-toggle-readonly-bg: #d9cfc5;
    --cc-toggle-on-knob-bg: #ffffff;
    --cc-cookie-category-block-bg: #ede5dc;
    --cc-cookie-category-block-border: #ede5dc;
    --cc-cookie-category-block-hover-bg: #e4dacd;
    --cc-cookie-category-block-hover-border: #e4dacd;
    --cc-overlay-bg: rgb(57 52 49 / 0.6);
    --cc-footer-bg: #ede5dc;
    --cc-footer-color: #5f5955;
    --cc-footer-border-color: #ddd0c3;
    --cc-link-color: #742f46;
    --cc-modal-border-radius: 4px;
    --cc-btn-border-radius: 4px;
    --cc-pm-toggle-border-radius: 999px;
    --cc-modal-transition-duration: 0.2s;
  }
  #cc-main .cm__title,
  #cc-main .pm__title {
    font-family: var(--font-serif);
    font-weight: 500;
  }
  /* Tlačidlá v tvare pilulky; sekcie a ostatné bloky dedia 4 px z --cc-btn-border-radius */
