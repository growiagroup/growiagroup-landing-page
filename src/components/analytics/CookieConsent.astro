---
/**
 * Cookie lišta (vanilla-cookieconsent v3) prepojená na Google Consent Mode v2.
 * Tlačidlá s atribútom data-cc="show-preferencesModal" otvoria nastavenia.
 */
---

<script>
  import 'vanilla-cookieconsent/dist/cookieconsent.css';
  import * as CookieConsent from 'vanilla-cookieconsent';
  import { cookieConsentTexts } from '@/data/cookieConsent';
  import { cookieCategories, consentCookie, rootDomain } from '@/data/cookies';
  import { consentFromCategories } from '@/lib/consent';

  type Gtag = (...args: unknown[]) => void;
  declare global {
    interface Window {
      dataLayer?: unknown[];
      gtag?: Gtag;
    }
  }

  function applyConsent(categories: string[]) {
    const consent = consentFromCategories(categories);
    window.dataLayer = window.dataLayer ?? [];
    const gtag: Gtag =
      window.gtag ??
      function () {
        // eslint-disable-next-line prefer-rest-params
        window.dataLayer!.push(arguments);
      };
    gtag('consent', 'update', consent);
    window.dataLayer.push({ event: 'cookie_consent_update', consent_categories: categories });
  }

  /**
   * Cookies, ktoré lišta vymaže po odvolaní súhlasu s kategóriou. Google ich ukladá
   * na hlavnú doménu, preto každý vzor uvádzame aj s doménou, aj bez nej.
   */
  const autoClearFor = (patterns: RegExp[]) =>
    patterns.length === 0
      ? undefined
      : { cookies: patterns.flatMap((name) => [{ name }, { name, domain: rootDomain }]) };

  const categories = Object.fromEntries(
    cookieCategories.map((category) => [
      category.id,
      category.id === 'necessary'
        ? { enabled: true, readOnly: true }
        : { autoClear: autoClearFor(category.autoClear) },
    ]),
  );

  CookieConsent.run({
    cookie: { name: consentCookie.name, expiresAfterDays: consentCookie.expiresAfterDays },
    guiOptions: {
      consentModal: { layout: 'box', position: 'bottom left', equalWeightButtons: true, flipButtons: false },
      preferencesModal: { layout: 'box', equalWeightButtons: true, flipButtons: false },
    },
    categories,
    language: {
      default: 'sk',
      translations: {
        sk: {
          consentModal: { ...cookieConsentTexts.consentModal },
          preferencesModal: { ...cookieConsentTexts.preferencesModal },
        },
      },
    },
    onConsent: ({ cookie }) => applyConsent(cookie.categories),
    onChange: ({ cookie }) => applyConsent(cookie.categories),
  });
</script>

<style is:global>
  /* Prispôsobenie vzhľadu cookie lišty dizajnu webu */
  #cc-main {
    --cc-font-family: var(--font-sans);
    --cc-bg: #f5f0e8;
