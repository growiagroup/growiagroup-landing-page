---
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TeamMember from '@/components/ui/TeamMember.astro';
import { team } from '@/data/team';
---

<Section id="tim" tone="muted" aria-labelledby="tim-title">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-[clamp(32px,5vw,72px)] items-end">
    <div class="flex flex-col gap-[18px]">
      <SectionHeading id="tim-title" eyebrow={team.eyebrow} title={team.title} />
      <p class="m-0 max-w-[58ch] text-ink-2">{team.intro}</p>
    </div>
    {
      team.groupPhoto ? (
        <div class="aspect-[589/248] overflow-hidden rounded-sm bg-stone">
          <img
            src={team.groupPhoto.src}
            width={team.groupPhoto.width}
            height={team.groupPhoto.height}
            alt={team.groupPhotoAlt}
            loading="lazy"
            decoding="async"
            class="block w-full h-full object-cover object-[50%_20%]"
          />
        </div>
      ) : (
        <div class="pattern-light aspect-[589/248] rounded-sm bg-stone" aria-hidden="true" />
      )
    }
  </div>

  <div class="mt-[clamp(48px,6vw,80px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,500px),1fr))] gap-[clamp(48px,5vw,72px)]">
    {team.members.map((member) => <TeamMember member={member} />)}
  </div>
</Section>
