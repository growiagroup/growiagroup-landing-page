---
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TeamMember from '@/components/ui/TeamMember.astro';
import { team } from '@/data/team';
---

<Section id="tim" tone="muted" aria-labelledby="tim-title">
  <SectionHeading id="tim-title" eyebrow={team.eyebrow} title={team.title} maxWidth="max-w-[46rem]" />
  <p class="m-0 mt-[18px] max-w-[58ch] text-ink-2">{team.intro}</p>

  <div class="mt-[clamp(48px,6vw,80px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,500px),1fr))] gap-[clamp(48px,5vw,72px)]">
    {team.members.map((member) => <TeamMember member={member} />)}
  </div>
</Section>
