---
import IconFeature from '@/components/ui/IconFeature.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { forWhom } from '@/data/forWhom';
---

<Section id="pre-koho" tone="muted" aria-labelledby="pre-koho-title">
  <SectionHeading id="pre-koho-title" eyebrow={forWhom.eyebrow} title={forWhom.title} />
  <p class="m-0 mt-6 font-serif font-medium text-[clamp(20px,1rem+0.6vw,24px)] leading-[1.25]">
    {forWhom.intro}
  </p>
  <div class="mt-[clamp(40px,5vw,64px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-x-8 border-t border-ink/32">
    {forWhom.items.map((item) => (
      <IconFeature icon={item.icon} title={item.title} helpLabel={forWhom.helpLabel} help={item.help} />
    ))}
  </div>
</Section>
