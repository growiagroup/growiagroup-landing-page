---
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import heroImage from '@/assets/images/hero-office.webp';
import { hero } from '@/data/hero';
import { site } from '@/config/site';
---

<Section
  id="top"
  padding="hero"
  containerClass="grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] gap-[clamp(48px,5vw,72px)] items-center"
>
  <div class="flex flex-col gap-[26px] min-w-0">
    <Eyebrow>{hero.eyebrow}</Eyebrow>
    <h1 class="m-0 font-serif font-semibold text-[clamp(38px,2rem+2.4vw,56px)] leading-[1.06] tracking-[-0.005em] max-w-[11ch]">
      {hero.title}&nbsp;<span class="text-accent [text-wrap:initial]">{hero.titleAccent}</span>
    </h1>
    <p class="m-0 text-[14px] leading-[1.6] text-ink-2 max-w-[528px]">{hero.lead}</p>
    <div class="flex flex-wrap items-center gap-x-7 gap-y-[14px]">
      <Button href={site.cta.href} cta="hero">{site.cta.label}</Button>
      <a
        href={hero.secondaryLink.href}
        class="inline-flex items-center min-h-[44px] font-bold underline decoration-taupe decoration-[1.5px] underline-offset-[5px]"
      >
        {hero.secondaryLink.label}
      </a>
    </div>
  </div>

  <div class="relative w-full max-w-[460px] justify-self-center mb-6">
    <div class="relative aspect-[3/4] overflow-hidden rounded-sm bg-stone">
      <Picture
        src={heroImage}
        alt={hero.image.alt}
        widths={[400, 600, 800]}
        sizes="(max-width: 520px) 100vw, 460px"
        formats={['avif']}
        fallbackFormat="webp"
        pictureAttributes={{ class: 'block w-full h-full' }}
        loading="eager"
        fetchpriority="high"
        class="block w-full h-full object-cover"
      />
    </div>
  </div>
</Section>
