---
import LegalLayout from '@/layouts/LegalLayout.astro';
import Button from '@/components/ui/Button.astro';
import { cookiesPage } from '@/data/legal';
---

<LegalLayout page={cookiesPage} path="/zasady-cookies">
  <div>
    <button
      type="button"
      data-cc="show-preferencesModal"
      class="inline-flex items-center justify-center min-h-[52px] px-[30px] py-[14px] rounded-full bg-accent text-white font-bold text-[16px] border-0 cursor-pointer hover:bg-accent-hover"
    >
      Zmeniť nastavenia cookies
    </button>
  </div>
</LegalLayout>
