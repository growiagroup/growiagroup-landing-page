---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
---

<Layout title="Stránka sa nenašla – Growia Group" description="Požadovaná stránka neexistuje." path="/404" noindex>
  <Header />
  <main>
    <Section containerClass="max-w-[40rem] flex flex-col items-start gap-5 min-h-[50vh]">
      <p class="eyebrow text-accent">Chyba 404</p>
      <h1 class="m-0 font-serif font-medium text-h2">Táto stránka neexistuje</h1>
      <p class="m-0 text-lead text-ink-2">Odkaz je pravdepodobne neplatný alebo stránka bola presunutá.</p>
      <Button href="/" class="mt-2">Späť na úvodnú stránku</Button>
    </Section>
  </main>
  <Footer />
</Layout>
