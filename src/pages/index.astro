---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import ForWhom from '@/components/sections/ForWhom.astro';
import Process from '@/components/sections/Process.astro';
import Results from '@/components/sections/Results.astro';
import Team from '@/components/sections/Team.astro';
import Models from '@/components/sections/Models.astro';
import Faq from '@/components/sections/Faq.astro';
---

<Layout
  title="Growia Group – externé obchodné oddelenie a B2B akvizícia"
  description="Aktívne telefonicky oslovujeme potenciálnych zákazníkov vo vašom mene, identifikujeme obchodný potenciál a vytvárame nové B2B obchodné príležitosti."
>
  <Header />
  <main>
    <Hero />
    <ForWhom />
    <Process />
    <Results />
    <Team />
    <Models />
    <Faq />
  </main>
</Layout>
