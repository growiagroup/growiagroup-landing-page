---
import '@/styles/global.css';
import Seo from '@/components/seo/Seo.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import GoogleTagManager from '@/components/analytics/GoogleTagManager.astro';
import CookieConsent from '@/components/analytics/CookieConsent.astro';
import { site } from '@/config/site';
import { availableHeadingFonts, fontFaceCss } from '@/lib/headingFont';
import { webPageSchema } from '@/lib/structuredData';

interface Props {
  title: string;
  description: string;
  /** Cesta stránky, napr. "/" alebo "/dakujeme". Používa sa pre canonical. */
  path?: string;
  /** Stránky, ktoré nemajú byť indexované (ďakovacia stránka, 404). */
  noindex?: boolean;
}

const { title, description, path = '/', noindex = false } = Astro.props;
const headingFontCss = fontFaceCss(availableHeadingFonts());
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} path={path} noindex={noindex} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f5f0e8" />
    <meta name="generator" content={Astro.generator} />
    {
      site.fontKitUrl && (
        <>
          <link rel="preconnect" href="https://use.typekit.net" crossorigin />
          <link rel="preconnect" href="https://p.typekit.net" crossorigin />
          <link rel="stylesheet" href={site.fontKitUrl} />
        </>
      )
    }
    {headingFontCss && <style set:html={headingFontCss} />}
    <JsonLd data={webPageSchema(title, description, path)} />
    <slot name="head" />
    <GoogleTagManager part="head" />
  </head>
  <body>
    <GoogleTagManager part="body" />
    <slot />
    <CookieConsent />
  </body>
</html>
