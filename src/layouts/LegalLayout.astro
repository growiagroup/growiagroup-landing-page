---
/** Podstránka s dlhším textom (právne informácie). */
import Layout from './Layout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import Section from '@/components/ui/Section.astro';
import type { LegalPage } from '@/data/legal';

interface Props {
  page: LegalPage;
  path: string;
}
const { page, path } = Astro.props;
---

<Layout title={`${page.title} – Growia Group`} description={page.description} path={path}>
  <Header />
  <main>
    <Section containerClass="max-w-[52rem]">
      <h1 class="m-0 font-serif font-medium text-h2">{page.title}</h1>
      {page.updated && <p class="m-0 mt-3 text-[14px] text-ink-2">Posledná aktualizácia: {page.updated}</p>}
      {page.draft && (
        <p class="m-0 mt-6 px-4 py-3 rounded-sm bg-bg-2 border border-ink/18 text-[15px]">
          Tento dokument sa pripravuje. Finálne znenie doplníme čoskoro.
        </p>
      )}
      <div class="mt-10 flex flex-col gap-8">
        {page.sections.map((section) => (
          <section class="flex flex-col gap-3">
            {section.heading && <h2 class="m-0 font-serif font-medium text-[24px] leading-[1.25]">{section.heading}</h2>}
            {section.paragraphs.map((text) => (
              <p class="m-0 text-ink-2" set:html={text} />
            ))}
          </section>
        ))}
        <slot />
      </div>
    </Section>
  </main>
  <Footer />
</Layout>
